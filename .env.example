# ============================================================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client — Public Only)
# ============================================================================
# NEVER put any secret key, service role key, or Lemon Squeezy secret here.
VITE_SUPABASE_URL=https://sbrzxvujrylyohmybddj.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_STAGING_SUPABASE_ANON_KEY_HERE
VITE_LEMONSQUEEZY_ENABLED=false
VITE_LEMONSQUEEZY_MODE=disabled

# ============================================================================
# 2. SUPABASE EDGE FUNCTIONS SECRETS (Server-Side Only — Never Exposed to Client)
# ============================================================================
# Configure via: supabase secrets set --project-ref sbrzxvujrylyohmybddj KEY=VALUE
#
# Payment Provider Activation & Mode:
# - LEMONSQUEEZY_ENABLED: "false" (default while store awaits activation) or "true"
# - LEMONSQUEEZY_MODE: "disabled" (default) | "test" | "live"
LEMONSQUEEZY_ENABLED=false
LEMONSQUEEZY_MODE=disabled

# Verified Variant Currency (ISO 4217 code e.g. USD, EUR, GBP, CAD, AUD, JPY):
# Used by lemon-checkout to verify that custom_price matches the Lemon Squeezy variant currency.
LEMONSQUEEZY_VARIANT_CURRENCY=USD

# Dedicated Test Mode Secrets (Used ONLY when LEMONSQUEEZY_MODE=test):
LEMONSQUEEZY_TEST_API_KEY=
LEMONSQUEEZY_TEST_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_STORE_ID=

# Dedicated Live Mode Secrets (Used ONLY when LEMONSQUEEZY_MODE=live):
LEMONSQUEEZY_LIVE_API_KEY=
LEMONSQUEEZY_LIVE_WEBHOOK_SECRET=
LEMONSQUEEZY_LIVE_STORE_ID=

# Generic fallback variables (LEMONSQUEEZY_API_KEY, LEMONSQUEEZY_WEBHOOK_SECRET, LEMONSQUEEZY_STORE_ID)
# are STRICTLY FORBIDDEN and never read by Edge Functions to guarantee Test/Live isolation.

# Trusted Checkout Redirect Origins Allowlist (Comma-separated HTTPS origins):
ALLOWED_CHECKOUT_ORIGINS=https://pageads.ahmedkhalled1994.workers.dev,https://ais-dev-elow2pgon3diltn3hthovi-718657541875.europe-west1.run.app,https://ais-pre-elow2pgon3diltn3hthovi-718657541875.europe-west1.run.app

# ============================================================================
# 3. STAGING VERIFICATION & DEPLOYMENT VARIABLES (Local DevOps / CI Only)
# ============================================================================
# Target Staging Project Reference: sbrzxvujrylyohmybddj
STAGING_SUPABASE_PROJECT_REF=sbrzxvujrylyohmybddj
STAGING_SUPABASE_URL=https://sbrzxvujrylyohmybddj.supabase.co
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_DB_URL=
